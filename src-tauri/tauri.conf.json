{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "wifisend",
  "version": "0.1.1",
  "identifier": "local.kuaichuan.drop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "快传",
        "width": 1080,
        "height": 760,
        "minWidth": 880,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
